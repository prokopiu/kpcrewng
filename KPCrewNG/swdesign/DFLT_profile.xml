<?xml version="1.0" encoding="UTF-8"?>
<kpcrewng xmlns="http://www.w3schools.com"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.w3schools.com DFLT_profile.xsd">
	<addon icao="DFLT" title="Laminar X-Plane Default Aircraft">
		<sop title="DFLT Standard Operating Procedure"><!--Addon has exactly one SOP -->
			<flows><!--Associated flows - a repeating section with element flow -->
				<flow title="Title of flow to be added" flightPhase="1"
					className="Flow"><!--FlightPhase index 1-21, className ChecklistFlow, ProcedureFlow, 
						BackgroundFlow, StateFlow -->
					<flowItems><!--comment -->
						<flowItem challenge="text on left side of procedure"
							response="text on right side of procedure" role="1"
							className="ProcedureItem">
						</flowItem>
					</flowItems>
				</flow>
			</flows>
		</sop>
	</addon>
</kpcrewng>